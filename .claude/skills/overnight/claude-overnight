#!/usr/bin/env bash
# claude-overnight — one-off vault access for Claude Code runs via ephemeral
# 1Password service accounts. The token lives only in the child process env
# (or, for grants, travels 1P-item-to-1P-item) and self-expires via TTL —
# except --token-file, which uses a standing SA whose own (months-long)
# expiry applies; see that mode's notes.
#
# Modes:
#   claude-overnight <vault> [options] [-- <claude args...>]
#       Local/admin: mint an ephemeral SA for <vault>, launch claude with it.
#       Needs the 1P desktop-app session and SA-create (owner/admin) rights.
#
#   claude-overnight grant <vault> <user> [options]
#       Local/admin: mint the SA, deliver its token as an item in vault
#       milton-user-<user> (never displayed). For teammates on Coder
#       workspaces, whose standing 1P auth is itself a service account and
#       therefore cannot mint.
#
#   claude-overnight --token-from <op-ref> [options] [-- <claude args...>]
#       Workspace: launch claude with a token an admin granted you, read via
#       your standing workspace auth, e.g.
#       --token-from "op://milton-user-aya-y/overnight-feishu-mcp-.../credential"
#
#   claude-overnight --token-file <path> [options] [-- <claude args...>]
#       Launch with a standing SA token from a local env file (raw token or an
#       OP_SERVICE_ACCOUNT_TOKEN= line), e.g. ~/.config/op/claude-automation.env.
#       For detached relaunches while the 1P desktop session is locked (minting
#       needs biometric). No launcher TTL — the SA's own expiry/scope is the
#       fence. The file must be chmod 600. Refuses tokens that can see
#       prod / local-infra / Infra Ops vaults, and pass --expect <vault>
#       (repeatable) to additionally refuse anything outside that list —
#       always do; the name denylist alone is convention-dependent.
#
# Options:
#   -t, --ttl <dur>        SA lifetime: 30m, 12h, 1d, 1w  (default: 12h)
#   -v, --vault <name>     grant an additional vault, read-only (repeatable)
#   -w, --write            grant write_items on the PRIMARY vault only
#       --infra            also grant "Infra Ops" read-only (unattended runs:
#                          think twice — shared fleet secrets, read = exfil)
#   -d, --dir <path>       cd here before launching claude
#   -p, --prompt-file <f>  headless mode: read the task prompt from this file
#       --expect <vault>   (--token-file only) refuse tokens that see any vault
#                          not in this list (repeatable)
#       --check            show what the token sees instead of launching
#   -h, --help             show this help
#
# Vault names containing "prod" or "local-infra" (any case) are refused:
# unattended runs never get prod or attended-admin-only vaults. Expired SA
# objects linger in the 1P admin console (the CLI cannot delete them); all are
# named overnight-* for periodic bulk cleanup.
set -euo pipefail

die() { echo "claude-overnight: $*" >&2; exit 1; }
usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0"; }

mode=launch grant_user="" token_ref="" token_file=""
case "${1:-}" in
  "")           usage >&2; exit 1 ;;
  -h|--help)    usage; exit 0 ;;
  grant)        mode=grant; shift
                [[ $# -ge 2 && "$1" != -* && "$2" != -* ]] \
                  || die "usage: claude-overnight grant <vault> <user> [options]"
                vaults=("$1"); grant_user="$2"; shift 2 ;;
  --token-from) mode=consume; shift
                [[ $# -ge 1 && "$1" == op://* ]] \
                  || die "--token-from requires an op://vault/item/field reference"
                token_ref="$1"; shift; vaults=(unused) ;;
  --token-file) mode=tokenfile; shift
                [[ $# -ge 1 && "$1" != -* ]] \
                  || die "--token-file requires a path"
                token_file="$1"; shift; vaults=(unused) ;;
  -*)           die "first argument must be a vault name, 'grant', --token-from, or --token-file" ;;
  *)            vaults=("$1"); shift ;;
esac

ttl=12h ttl_set=0 write_primary=0 dir="" check=0 prompt_file="" extra_vaults=0
expect_vaults=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -t|--ttl)         [[ $# -ge 2 ]] || die "$1 requires an argument"; ttl="$2"; ttl_set=1; shift 2 ;;
    -v|--vault)       [[ $# -ge 2 ]] || die "$1 requires an argument"; vaults+=("$2"); extra_vaults=1; shift 2 ;;
    -w|--write)       write_primary=1; shift ;;
    --infra)          vaults+=("Infra Ops"); extra_vaults=1; shift ;;
    -d|--dir)         [[ $# -ge 2 ]] || die "$1 requires an argument"; dir="$2"; shift 2 ;;
    -p|--prompt-file) [[ $# -ge 2 ]] || die "$1 requires an argument"; prompt_file="$2"; shift 2 ;;
    --expect)         [[ $# -ge 2 ]] || die "$1 requires an argument"; expect_vaults+=("$2"); shift 2 ;;
    --check)          check=1; shift ;;
    -h|--help)        usage; exit 0 ;;
    --)               shift; break ;;
    *)                die "unknown option: $1 (use -- before claude args)" ;;
  esac
done

if [[ "$mode" == consume || "$mode" == tokenfile ]]; then
  [[ "$ttl_set" -eq 0 && "$extra_vaults" -eq 0 && "$write_primary" -eq 0 ]] \
    || die "-t/-v/-w/--infra don't apply with --token-from/--token-file (the token fixed the scope)"
fi
if [[ "$mode" != tokenfile && "${#expect_vaults[@]}" -gt 0 ]]; then
  die "--expect only applies to --token-file"
fi
if [[ "$mode" == grant ]]; then
  [[ -z "$dir" && -z "$prompt_file" && "$check" -eq 0 ]] \
    || die "-d/-p/--check don't apply to grant (the recipient launches, not you)"
  case "$grant_user" in
    *[!a-zA-Z0-9-]*|"") die "user must be the milton-user-<user> suffix, e.g. aya-y" ;;
  esac
fi

# Preflights — nothing is minted or fetched until these pass.
if [[ "$mode" != grant ]]; then
  command -v claude >/dev/null || die "claude not found on PATH"
  if [[ -n "$dir" ]]; then cd "$dir" || die "can't cd to $dir"; fi
  if [[ -n "$prompt_file" ]]; then [[ -r "$prompt_file" ]] || die "can't read prompt file: $prompt_file"; fi
fi

if [[ "$mode" == tokenfile ]]; then
  # Standing SA token from a local env file (e.g. ~/.config/op/claude-automation.env).
  # For when the 1P desktop session is locked and minting can't biometric-prompt
  # (detached/overnight relaunch). No TTL from this launcher — the SA's own expiry
  # and vault scope, fixed at creation, are the whole fence.
  command -v jq >/dev/null || die "jq required for --token-file (the vault scope check must not fail open)"
  [[ -r "$token_file" ]] || die "can't read token file: $token_file"
  perms=$(stat -f '%Lp' "$token_file" 2>/dev/null || stat -c '%a' "$token_file" 2>/dev/null) || true
  case "$perms" in
    *00) ;;
    *)   die "token file $token_file is group/world-readable (perms ${perms:-unknown}) — chmod 600 it" ;;
  esac
  token=$(sed -n 's/^\(export \)\{0,1\}OP_SERVICE_ACCOUNT_TOKEN=//p' "$token_file" | head -n1 | tr -d '"'"'"'\r') || true
  [[ -n "$token" ]] || token=$(grep -m1 -Ev '^[[:space:]]*(#|$)' "$token_file" | tr -d '"'"'"'\r') || true
  [[ -n "$token" ]] || die "no OP_SERVICE_ACCOUNT_TOKEN in $token_file"
  case "$token" in
    *[!A-Za-z0-9._=-]*) die "token in $token_file has an unexpected charset — not a 1P service-account token" ;;
  esac
  # Same unattended guardrail as minting, enforced on what the token can SEE.
  # Materialized via command substitution (NOT process substitution) so a jq or
  # op failure dies here instead of silently skipping the scope check.
  visible=$(OP_SERVICE_ACCOUNT_TOKEN="$token" op vault list --format json 2>/dev/null) \
    || die "token in $token_file can't list vaults (expired or malformed?)"
  names=$(printf '%s' "$visible" | jq -r '.[].name') \
    || die "couldn't parse the token's vault list — refusing to launch unvetted"
  [[ -n "$names" ]] || die "token sees no vaults — wrong or dead token"
  while IFS= read -r vn; do
    vn_lc=$(printf '%s' "$vn" | tr '[:upper:]' '[:lower:]')
    case "$vn_lc" in
      *prod*)        die "refusing token: it reaches vault '$vn' (contains 'prod') — do prod work attended" ;;
      *local-infra*) die "refusing token: it reaches vault '$vn' — attended-admin-only" ;;
      *infra?ops*)   die "refusing token: it reaches vault '$vn' — shared fleet secrets need the explicit --infra mint path, attended" ;;
    esac
    if [[ "${#expect_vaults[@]}" -gt 0 ]]; then
      ev_ok=0
      for ev in ${expect_vaults[@]+"${expect_vaults[@]}"}; do
        [[ "$vn" == "$ev" ]] && ev_ok=1
      done
      [[ "$ev_ok" -eq 1 ]] || die "token reaches vault '$vn', which is not in the --expect list — refusing"
    fi
    echo "» standing token ($token_file) — vault: $vn (read scope fixed at SA creation, no launcher TTL)" >&2
  done <<EOF
$names
EOF
elif [[ "$mode" == consume ]]; then
  # Uses the CALLER's standing auth (e.g. the workspace service-account token).
  token=$(op read "$token_ref") \
    || die "couldn't read the granted token (expired grant? wrong reference?)"
else
  # Minting must run as a human 1P session — a service account can't mint
  # service accounts. (No `op whoami` preflight: it always reports "not signed
  # in" under desktop-app integration; `op vault get` below is the session
  # probe and fails with op's own sign-in guidance.)
  unset OP_SERVICE_ACCOUNT_TOKEN

  primary="${vaults[0]}"
  vault_flags=()
  seen=" "
  for v in "${vaults[@]}"; do
    case "$seen" in *" ${v} "*) continue ;; esac
    seen="${seen}${v} "
    [[ "$v" != -* ]]      || die "vault name can't start with '-': $v"
    [[ "$v" != *[:,]* ]]  || die "vault name can't contain ':' or ',': $v"
    v_lc=$(printf '%s' "$v" | tr '[:upper:]' '[:lower:]')
    case "$v_lc" in
      *prod*)        die "refusing '$v' for an unattended run (name contains 'prod') — do prod work attended" ;;
      *local-infra*) die "refusing '$v' for an unattended run — local-infra-ops is attended-admin-only" ;;
    esac
    op vault get "$v" >/dev/null || die "vault not found: $v"
    p=read_items
    if [[ "$v" == "$primary" && "$write_primary" -eq 1 ]]; then p=read_items,write_items; fi
    vault_flags+=(--vault "${v}:${p}")
  done

  target_vault=""
  if [[ "$mode" == grant ]]; then
    target_vault="milton-user-${grant_user}"
    op vault get "$target_vault" >/dev/null || die "user vault not found: $target_vault"
  fi

  [[ "$check" -eq 0 ]] || ttl=1m
  primary_slug=$(printf '%s' "$primary" | tr -c '[:alnum:]' '-')
  sa_name="overnight-${primary_slug}-$(date +%Y%m%d-%H%M%S)-$$"

  token=$(op service-account create "$sa_name" --expires-in "$ttl" "${vault_flags[@]}" --raw) \
    || die "service account creation failed"
  echo "» $sa_name — vaults:$seen($([[ "$write_primary" -eq 1 ]] && echo "write on $primary, rest ")read-only), expires in $ttl" >&2
fi

if [[ "$mode" == grant ]]; then
  case "$token" in
    *[!A-Za-z0-9._=-]*) die "minted token has unexpected charset; not writing it anywhere" ;;
  esac
  item_title="overnight-${primary_slug}-$(date +%Y%m%d-%H%M)"
  printf '{"title":"%s","category":"API_CREDENTIAL","vault":{"name":"%s"},"tags":["overnight"],"fields":[{"id":"credential","type":"CONCEALED","label":"credential","value":"%s"},{"id":"notesPlain","type":"STRING","purpose":"NOTES","label":"notesPlain","value":"one-off overnight grant: %s(%s). Self-expires; safe to delete after the run."}]}' \
      "$item_title" "$target_vault" "$token" "$seen" "$ttl" \
    | op item create - >/dev/null || die "couldn't write the token item to $target_vault"
  ref="op://${target_vault}/${item_title}/credential"
  echo "» granted. Tell ${grant_user} to run:" >&2
  echo "  claude-overnight --token-from '$ref' -p task.txt -- --permission-mode acceptEdits" >&2
  exit 0
fi

export OP_SERVICE_ACCOUNT_TOKEN="$token"
if [[ "$check" -eq 1 ]]; then
  op vault list
  exit 0
fi
if [[ -n "$prompt_file" ]]; then
  # Headless runs die on transient API drops ("Connection closed mid-response").
  # Pin the session id up front so a failed attempt can be resumed in place,
  # bounded retries with linear backoff. A caller-supplied --resume/--session-id
  # is honored (resume that session instead of starting fresh).
  base_args=() session_id="" resume=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --resume)         [[ $# -ge 2 && "$2" != -* ]] || die "--resume requires a session id"
                        session_id="$2" resume=1; shift 2 ;;
      --resume=*)       session_id="${1#--resume=}" resume=1; shift ;;
      --session-id)     [[ $# -ge 2 && "$2" != -* ]] || die "--session-id requires a session id"
                        session_id="$2"; shift 2 ;;
      --session-id=*)   session_id="${1#--session-id=}"; shift ;;
      *)                base_args+=("$1"); shift ;;
    esac
  done
  if [[ -z "$session_id" ]]; then
    session_id=$( { uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid 2>/dev/null; } | tr '[:upper:]' '[:lower:]') || true
    [[ -n "$session_id" ]] || die "can't generate a session id (no uuidgen or /proc fallback)"
  fi
  # Every nonzero exit is retried, including permanent ones — worst case
  # ~15 min of backoff before giving up. Bounded, so acceptable unattended.
  max_retries=5 attempt=0
  while :; do
    rc=0
    if [[ "$attempt" -eq 0 && "$resume" -eq 0 ]]; then
      claude ${base_args[@]+"${base_args[@]}"} --session-id "$session_id" -p < "$prompt_file" || rc=$?
    else
      claude ${base_args[@]+"${base_args[@]}"} --resume "$session_id" -p \
        "The previous attempt was interrupted mid-run (transient API error or crash). Re-read the task instructions at the start of this session and continue from where you left off. Re-verify uncommitted state with git status before assuming a step completed." \
        || rc=$?
    fi
    [[ "$rc" -eq 0 ]] && exit 0
    attempt=$((attempt + 1))
    [[ "$attempt" -le "$max_retries" ]] \
      || die "claude exited rc=$rc; giving up after $max_retries resume retries (session $session_id)"
    echo "» claude exited rc=$rc — resuming session $session_id (retry $attempt/$max_retries) in $((attempt * 60))s" >&2
    sleep $((attempt * 60))
  done
fi
exec claude "$@"
